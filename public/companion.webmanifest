{
  "name": "ZeroNeurone",
  "short_name": "ZeroNeurone",
  "description": "ZeroNeurone mobile companion",
  "start_url": "m/",
  "scope": "./",
  "display": "standalone",
  "theme_color": "#fffdf9",
  "background_color": "#fffdf9",
  "icons": [
    {
      "src": "logo-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "logo-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "logo-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "m/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "video/*",
            "audio/*",
            "application/pdf",
            "text/*",
            "*/*"
          ]
        }
      ]
    }
  }
}
