# ============================================================================
# zeroneurone - Environment Configuration
# ============================================================================
# Copy this file to .env and adjust values for your deployment.

# Domain for Traefik (required for production)
ZERONEURONE_DOMAIN=zeroneurone.example.com

# Server configuration (usually no need to change)
# NODE_ENV=production
# PORT=3000
# HOST=0.0.0.0

# Docker registry for npm run docker:build
# Example: ghcr.io/username/zeroneurone or myregistry.com/org/zeroneurone
# DOCKER_REGISTRY=your-registry.example.com/org/zeroneurone

# Trust the X-Forwarded-For header to determine the client IP.
# Set to 1 ONLY when a reverse proxy in front of the server sets it.
# When the server is exposed directly, leaving this unset is what keeps the
# per-IP connection limit meaningful.
# TRUST_PROXY=1
