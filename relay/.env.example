# ============================================================================
# zeroneurone relay settings (relay/config.js)
# ============================================================================
# Copy as .env next to the relay (or set them in the environment: the
# environment wins over .env). Values shown are the standalone relay's
# defaults; the combined image (server/index.js) differs where noted.
# ENV_FILE=/path/to/file reads another file than ./.env.

# --- Server ------------------------------------------------------------------
# PORT=4444                     # combined image: 3000
# HOST=0.0.0.0
# REDIS_URL=redis://redis:6379  # persistent async buffer; memory when unset
# TRUST_PROXY=0                 # 1 only behind a proxy setting X-Forwarded-For
# ALLOWED_ORIGIN=*              # CORS origin for /health and /metrics

# --- Limits (abuse protection) ------------------------------------------------
# MAX_MESSAGE_SIZE_MB=100       # largest WebSocket message
# RATE_LIMIT=1500               # messages per window per client
# RATE_WINDOW_MS=1000
# MAX_CONNECTIONS_PER_IP=50     # combined image: 10
# MAX_CLIENTS_PER_ROOM=50
# MAX_ROOMS=1000
# MAX_ROOM_ID_LENGTH=128
# PING_INTERVAL_S=30            # keepalive ping
# PONG_TIMEOUT_MS=10000         # no pong in time: connection closed
# BACKPRESSURE_MB=256           # data waiting to reach a slow client before it
#                               # is disconnected (it reconnects and resyncs);
#                               # keep it above MAX_MESSAGE_SIZE_MB + BUFFER_SIZE_MB

# --- Async buffer (messages kept for clients that come later) ----------------
# BUFFER_SIZE_MB=50             # per room
# BUFFER_MAX_MSGS=100000        # per room; combined image: 10000
# BUFFER_AGE_HOURS=48           # combined image: 168 (7 days)
# BUFFER_MAX_ROOMS=             # rooms holding a buffer; MAX_ROOMS when unset
# BUFFER_TOTAL_GB=10            # all rooms together
# BUFFER_ORPHAN_HOURS=24        # buffer of a room left empty, dropped after
